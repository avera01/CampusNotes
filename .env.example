# Copy this file to .env and fill in real values for local development.
# .env is gitignored -- never commit real secrets.

# Used to sign session cookies and CSRF tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret

# SQLAlchemy connection string. Leave unset to use the default SQLite file
# at instance/campusnotes.db. Swap to a postgresql:// URL later without
# changing any application code.
# DATABASE_URL=sqlite:///campusnotes.db

# Path where uploaded files are stored. Leave unset to use the default
# (app/uploads next to the app package, resolved as an absolute path
# regardless of the process's working directory). If you do set this,
# use an absolute path -- a relative one is resolved against whatever
# directory the server process happens to be started from.
# UPLOAD_FOLDER=app/uploads

# Max upload size in megabytes.
MAX_UPLOAD_MB=20

# Google OAuth ("Sign in with Google"). Create these in Google Cloud
# Console -- see the README for step-by-step instructions and the exact
# redirect URI to register.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
